    "%@ has spec changes. Open Reqeast to review and apply them." : {
      "comment" : "Push notification body when a linked spec has updates.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat Spec-Änderungen. Öffnen Sie Reqeast, um sie zu prüfen und anzuwenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tiene cambios en la especificación. Abre Reqeast para revisarlos y aplicarlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a des modifications de la spécification. Ouvrez Reqeast pour les examiner et les appliquer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ に仕様の変更があります。Reqeast を開いて確認し、適用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 사양 변경 사항이 있습니다. Reqeast를 열어 검토하고 적용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tem alterações na especificação. Abra o Reqeast para revisar e aplicá-las."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的规范有更改。打开 Reqeast 以审查并应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的規格有變更。開啟 Reqeast 以審查並套用。"
          }
        }
      }
    },
