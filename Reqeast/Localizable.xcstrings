    "Host %@ is not allowed. Add it under Settings → Trusted Git Hosts." : {
      "comment" : "Git OAuth error for disallowed host.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Host %@ ist nicht erlaubt. Fügen Sie ihn unter Einstellungen → Vertrauenswürdige Git-Hosts hinzu."
