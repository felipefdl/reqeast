          }
        }
      }
    },
    "The server is delivering only part of the resource due to a range header sent by the client." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server liefert aufgrund eines vom Client gesendeten Range-Headers nur einen Teil der Ressource."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor entrega solo parte del recurso debido a una cabecera Range enviada por el cliente."
          }
