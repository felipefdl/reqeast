{
  "swagger": "2.0",
  "info": {
    "title": "Swagger Petstore",
    "description": "A sample API that uses a petstore as an example",
    "version": "1.0.7"
  },
  "host": "petstore.swagger.io",
  "basePath": "/v2",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "tags": [
    {
      "name": "pet",
      "description": "Everything about your Pets"
    },
    {
      "name": "store",
      "description": "Access to Petstore orders"
    }
  ],
  "paths": {
    "/pet": {
      "get": {
        "tags": [
          "pet"
        ],
        "summary": "List all pets",
        "operationId": "listPets",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "A paged array of pets"
          }
        }
      },
      "post": {
        "tags": [
          "pet"
        ],
        "summary": "Add a new pet",
        "operationId": "addPet",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Fluffy"
                },
                "status": {
                  "type": "string",
                  "example": "available"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/pet/{petId}": {
      "get": {
        "tags": [
          "pet"
        ],
        "summary": "Find pet by ID",
        "operationId": "getPetById",
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Pet found"
          }
        }
      }
    },
    "/store/order": {
      "post": {
        "tags": [
          "store"
        ],
        "summary": "Place an order",
        "operationId": "placeOrder",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "quantity": {
                  "type": "integer",
                  "example": 1
                },
                "shipDate": {
                  "type": "string",
                  "example": "2026-01-01T00:00:00Z"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Order placed"
          }
        }
      }
    }
  }
}
